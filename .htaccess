Options -ExecCGI -Indexes -MultiViews

# Never serve configuration, keys or database exports from the checkout.
<FilesMatch "(?i)(^\.(?!well-known)|\.(?:sql|bak|key|pem|env)(?:\..*)?$|^APIKEY\.txt$|^SECURITY-)">
    Require all denied
</FilesMatch>

# Only content-fingerprinted assets can be cached without revalidation.
# Unversioned legacy assets keep the server's normal cache policy.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ m#(^|&)v=[a-f0-9]{12}(&|$)#"
    </FilesMatch>
</IfModule>

<Files ".user.ini">
    Require all denied
</Files>

<FilesMatch "(?i)(^error_log(?:\.txt)?$|\.(?:log|jsonl)$)">
    Require all denied
</FilesMatch>

ErrorDocument  404  /404.php

RewriteEngine On

RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:docker|sql|tests|test|vendor|class|db|includes|scripts)(?:/|$) - [F,L]

# Uploaded files must never reach an executable handler, including alternate suffixes.
RewriteRule ^img/upload/.*\.(?:php[0-9]*|phtml|phar|cgi|pl|py|sh|shtml)(?:[./]|$) - [F,L,NC]

RewriteRule ^tmp(?:/|$) - [F,L]
RewriteRule ^log(?:/|$) - [F,L]
RewriteRule ^telegram/data(?:/|$) - [F,L]

RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^([A-Za-z0-9.-]+\.localtest\.me)(:80)?$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=302,L,NE]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^app(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !(^|\.)(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} ^([A-Za-z0-9.-]+)(?::\d+)?$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L,NE]

# MCP uses a stateless Streamable HTTP endpoint and public OAuth discovery.
RewriteRule ^api/v1(?:/.*)?$ /api/v1/index.php [QSA,END]
RewriteRule ^developer/?$ /developer/index.php [QSA,END]
RewriteRule ^mcp/?$ /mcp/index.php [QSA,L]
RewriteRule ^\.well-known/oauth-protected-resource(?:/mcp)?/?$ /mcp/metadata.php [L]
RewriteRule ^\.well-known/oauth-authorization-server/?$ /mcp/metadata.php [L]

# Serve the alternate homepage at the omo2.org root without changing the URL.
RewriteCond %{HTTP_HOST} ^(?:www\.)?omo2\.org(?::\d+)?$ [NC]
RewriteRule ^$ /views/omo2-home.php [QSA,L]

# Keep published URLs and POST bodies after moving root-level pages.
RewriteRule ^index2\.php$ /views/omo2-home.php [QSA,L]
RewriteRule ^migration-omo\.php$ /views/omo2-migration.php [QSA,L]
RewriteRule ^genWord\.php$ /pv/export.php [QSA,L]
RewriteRule ^omo1_export\.php$ /tools/migration/omo1-export.php [QSA,L]
RewriteRule ^stats\.php$ /common/admin/stats.php [QSA,L]
RewriteRule ^confirm\.php$ /common/confirm.php [QSA,L]
RewriteRule ^qr\.php$ /common/qr/index.php [QSA,L]

# Preserve direct links to the relocated guides and reports.
RewriteRule ^(DEPLOY|DOCKER)\.md$ /docs/$1.md [L]
RewriteRule ^(PERFORMANCE-[A-Z0-9-]+\.md)$ /docs/performance/$1 [L]

RewriteRule ^memo/?$ /memo/index.php [QSA,L]
RewriteRule ^memo/([0-9]+)/?$ /memo/index.php?open_document_id=$1 [QSA,L]
RewriteRule ^memo/([0-9]+)/([0-9a-f]+)/?$ /memo/view.php?id=$1&access_code=$2 [QSA,L]

RewriteRule ^circle/public/([0-9A-Za-z]+)/?$ /circle/index.php?view=$1 [QSA,L]

RewriteRule ^pv/([0-9]+)/?$ /pv/index.php?id=$1 [QSA,L]

RewriteRule ^meeting/([0-9A-Za-z-]+)/?$ /meeting/index.php?name=$1 [QSA,L]
RewriteRule ^event/register/([a-f0-9]{64})/?$ /event/index.php?token=$1 [QSA,L]
RewriteRule ^event/receipt/([a-f0-9]{64})/?$ /event/index.php?receipt=$1 [QSA,L]

RewriteRule ^calendar/share/([a-f0-9]{64})\.ics$ /common/calendar/feed.php?token=$1 [L]

RewriteRule ^decision/access/([0-9A-Za-z_-]+)/?$ /common/decision_participation.php?token=$1 [QSA,L]
RewriteRule ^decision/access/([0-9A-Za-z_-]+)/(view|participate)/?$ /common/decision_participation.php?token=$1&intent=$2 [QSA,L]
RewriteRule ^decision/public/([0-9]+)/([0-9]+)/?$ /common/decision_participation.php?public=1&oid=$1&id=$2 [QSA,L]
RewriteRule ^decision/public/([0-9]+)/([0-9]+)/(view|participate)/?$ /common/decision_participation.php?public=1&oid=$1&id=$2&intent=$3 [QSA,L]
RewriteRule ^decision/public/([0-9]+)/([0-9]+)/c/([0-9]+)/?$ /common/decision_participation.php?public=1&oid=$1&id=$2&cid=$3 [QSA,L]
RewriteRule ^decision/public/([0-9]+)/([0-9]+)/c/([0-9]+)/(view|participate)/?$ /common/decision_participation.php?public=1&oid=$1&id=$2&cid=$3&intent=$4 [QSA,L]

RewriteRule ^qr$ /common/qr/index.php [L]
RewriteRule ^qr/([0-9A-Za-z]+)/?$ /common/qr/index.php?id=$1 [QSA,L]
RewriteRule ^qr/([0-9]+)/([0-9A-Za-z_\-]+)/?$ /common/qr/index.php?uid=$1&id=$2 [QSA,L]
RewriteRule ^qr/image/([0-9A-Za-z]+)/?$ /common/qr/index.php?output=image&id=$1 [QSA,L]
RewriteRule ^qr/image/([0-9]+)/([0-9A-Za-z_\-]+)/?$ /common/qr/index.php?output=image&uid=$1&id=$2 [QSA,L]


# 👉 ignorer fichiers statiques
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|ico)$ [NC]

# 👉 routes OMO
RewriteRule ^omo/?$ /omo/index.php [QSA,L]
RewriteRule ^omo/c/[0-9]+/?$ /omo/index.php [QSA,L]
RewriteRule ^omo/o/[0-9]+(/c/[0-9]+)?/?$ /omo/index.php [QSA,L]
RewriteRule ^\.well-known/carddav/?$ /omo/api/carddav/ [R=302,L]
RewriteRule ^\.well-known/caldav/?$ /omo/api/caldav/ [R=302,L]
RewriteCond %{REQUEST_URI} !^/omo/api/carddav/index\.php$ [NC]
RewriteRule ^omo/api/carddav/?$ /omo/api/carddav/index.php [QSA,L]
RewriteCond %{REQUEST_URI} !^/omo/api/carddav/index\.php$ [NC]
RewriteRule ^omo/api/carddav/.+$ /omo/api/carddav/index.php [QSA,L]
RewriteCond %{REQUEST_URI} !^/omo/api/caldav/index\.php$ [NC]
RewriteRule ^omo/api/caldav/?$ /omo/api/caldav/index.php [QSA,L]
RewriteCond %{REQUEST_URI} !^/omo/api/caldav/index\.php$ [NC]
RewriteRule ^omo/api/caldav/.+$ /omo/api/caldav/index.php [QSA,L]
