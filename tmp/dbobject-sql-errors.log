{"time":"2026-06-29T10:53:37+02:00","query":"\n\t\t\t\tSELECT \n\t\t\t\t\tp.id,\n\t\t\t\t\tp.title,\n\t\t\t\t\tp.description,\n\t\t\t\t\tp.image,\n\t\t\t\t\tCOALESCE(p.IDorganization, (SELECT MIN(op_owner.IDorganization) FROM organization_parcours op_owner WHERE op_owner.IDparcours = p.id)) AS owner_organization_id,\n\t\t\t\t\tp.IDapplication AS linked_application_id,\n\t\t\t\t\tCOALESCE(p.ispack, 0) AS ispack,\n\t\t\t\t\top.position,\n\t\t\t\t\top.everybody,\n\t\t\t\t\top.anonymous,\n\t\t\t\t\tCOUNT(DISTINCT pm.IDmission) AS total_missions,\n\t\t\t\t\tCOALESCE(SUM(\n\t\t\t\t\t\tCASE \n\t\t\t\t\t\t\tWHEN lm.done IS NOT NULL THEN 1\n\t\t\t\t\t\t\tELSE 0\n\t\t\t\t\t\tEND\n\t\t\t\t\t), 0) AS done_missions\n\t\t\t\tFROM organization_parcours op\n\t\t\t\tINNER JOIN parcours p\n\t\t\t\t\tON p.id = op.IDparcours\n\t\t\t\tLEFT JOIN parcours_mission pm\n\t\t\t\t\tON pm.IDparcours = p.id\n\t\t\t\tLEFT JOIN user_mission lm\n\t\t\t\t\tON lm.IDmission = pm.IDmission\n\t\t\t\t\tAND lm.IDparcours = p.id\n\t\t\t\t\tAND lm.IDuser = :user_id\n\t\t\t\tWHERE op.IDorganization = :organization_id\n\t\t\t\tGROUP BY p.id, p.title, p.description, p.image, p.IDorganization, p.IDapplication, p.ispack, op.position, op.everybody, op.anonymous\n\t\t\t\tORDER BY op.position ASC, p.title ASC\n\t\t\t","params":{"user_id":1,"organization_id":1,"application_visibility_organization_id":1},"message":"SQLSTATE[HY093]: Invalid parameter number: parameter was not defined","code":0,"request_uri":"/omo/api/lms/?embed=1&oid=1","method":"GET","remote_addr":"172.18.0.1","script":"/omo/api/lms/index.php","database":"omodev","current_user":1,"current_organization":1}
