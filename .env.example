SITE_TITLE=EasyPV
HOME_TITLE=Home
APP_LANG=FR
ORGANIZATION_SUBDOMAIN_ROUTING=false
COOKIE_SCOPE_MODE=auto
COOKIE_ROOT_HOST=

DB_HOST=db
DB_NAME=omodev
DB_USER=omodev
DB_PASS=omodev
DB_MIGRATION_DATABASES=
DB_QUERY_LOG_ENABLED=false
DB_QUERY_LOG_MIN_MS=50
DB_QUERY_LOG_PATH=
RUNTIME_LOG_DIR=
AUTH_RATE_LIMITS_ENABLED=true
AUTH_RATE_LIMIT_SECRET=
AUTH_TRUSTED_PROXY_IPS=
# Canonical origin for security e-mails; required on non-local hosts.
AUTH_PUBLIC_URL=
AUTH_SECURITY_LOG_ENABLED=true
AUTH_SECURITY_ALERT_ENABLED=true
AUTH_SECURITY_ALERT_EMAIL=
AUTH_SECURITY_ALERT_COOLDOWN_SECONDS=3600
AUTH_TOTP_ENCRYPTION_KEY=
EXTERNAL_CALENDAR_ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_SECRET=

# Text and UI translation provider: openai, anthropic (Claude), mistral,
# openai_compatible, or disabled (stops text tools and new AI translations).
# Use an API key and exact model IDs from the selected provider's API console.
AI_PROVIDER=openai
# Only for openai_compatible: HTTPS base URL, without /chat/completions.
# OpenRouter by default; alternatives include https://api.mistral.ai/v1
# and https://api.groq.com/openai/v1. Use the selected service's key and model IDs.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Empty: existing OPENAI_MODEL for legacy OpenAI installations, else gpt-4o.
# Anthropic, Mistral and compatible services require an explicit model ID.
# Mistral example: mistral-small-latest.
AI_MODEL=
# Empty: main text model; legacy translation settings remain compatible.
# A smaller model from the same provider can reduce translation costs.
AI_TRANSLATION_MODEL=
# Audio is independent of the text provider: openai, groq, mistral or disabled.
TRANSCRIPTION_PROVIDER=openai
# Empty: text key only when both providers are OpenAI or both are Mistral.
# OpenAI can also use legacy OPENAI_API_KEY; Groq requires a dedicated key.
# A saved dedicated key is retained; enter the right key when changing provider.
TRANSCRIPTION_API_KEY=
# Empty: OpenAI legacy model or gpt-4o-mini-transcribe; Groq whisper-large-v3-turbo;
# Mistral voxtral-mini-latest. Custom models must match the selected provider.
TRANSCRIPTION_MODEL=
# Existing OPENAI_API_KEY / OPENAI_MODEL / OPENAI_TRANSLATION_MODEL and
# OPENAI_TRANSCRIPTION_MODEL settings remain supported as legacy fallbacks.
STADIA_MAPS_API_KEY=
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
GETIMG_ALLOWED_HOSTS=

# One URL, or several equivalent public endpoints separated by commas. OMO picks
# the endpoint whose parent domain matches the current OMO domain.
ETHERPAD_URL=https://doc.example.org
ETHERPAD_API_KEY=
ETHERPAD_API_VERSION=1
ETHERPAD_COOKIE_DOMAIN=

ETHERCALC_URL=
ETHERCALC_INTERNAL_URL=
ETHERCALC_KEY=

SPACEDECK_URL=
SPACEDECK_INTERNAL_URL=
SPACEDECK_PROVISIONING_TOKEN=
SPACEDOCK_EXTERNAL_ACCESS_SECRET=

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=
MAIL_AUTH=false
MAIL_CHARSET=UTF-8
MAIL_USER=
MAIL_PASS=
# Technical sender for native/MCP object mail, e.g. noreply@example.org.
# Empty: noreply at the SMTP account domain, then AUTH_PUBLIC_URL / MCP_PUBLIC_URL.
# The SMTP provider must authorize this address/domain. Replies go to the member.
MAIL_FROM=
MAIL_TIMEOUT=10

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.org
# Advanced: PHP CLI executable used to send push notifications in the background.
# Empty: automatic detection. Set only if background sending cannot start,
# e.g. /usr/bin/php. Use a CLI executable, never php-fpm or php-cgi.
NOTIFICATION_WORKER_PHP_BINARY=
SITE_UPDATE_COMPOSER_BINARY=
SITE_UPDATE_PHP_BINARY=
NOTIFICATION_PUSH_WORKER_LOG=
OMO_CRON_TOKEN=
OMO_CRON_LOG_ENABLED=true
OMO_CRON_LOG_PATH=

TELEGRAM_BOT_TOKEN=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
# Central OAuth endpoint; Patreon credentials are configured on this host.
PATREON_CONNECT_URL=https://omo2.org/common/patreon_connect.php
# Optional comma-separated HTTPS origins; *.domain matches its subdomains, not the root domain.
PATREON_CONNECT_ALLOWED_ORIGINS=https://opengov.tools,https://dev.opengov.tools,https://*.dev.opengov.tools,https://beta.opengov.tools,https://omo2.org,https://*.omo2.org,https://openmyorganization.org
PATREON_REDIRECT_URI=https://omo2.org/common/patreon_callback.php
PATREON_CREATOR_CAMPAIGN_ID=
# Optional AI access for the creator: numeric Patreon user ID verified by OAuth,
# not the campaign ID, OMO user ID, e-mail address or public profile name.
PATREON_CREATOR_USER_ID=
PATREON_USER_AGENT=EasyPV Patreon Sync
GITHUB_BUGREPORT_TOKEN=
GITHUB_BUGREPORT_REPO_OWNER=OpenGovernance-community
GITHUB_BUGREPORT_REPO_NAME=OMO2
GITHUB_BUGREPORT_LABELS=
GITHUB_BUGREPORT_USER_AGENT=OMO Bug Reporter

# Optional MCP access for assistants; canonical HTTPS endpoint ending in /mcp/.
# Leave empty to disable both MCP and its associated REST API.
MCP_PUBLIC_URL=
# Advanced, local development only: allow HTTP for the MCP URL and OAuth
# redirect URIs on localhost, 127.0.0.1 or ::1. Keep false on public sites.
MCP_ALLOW_LOCAL_HTTP=false
# Advanced: extra browser origins (scheme, host and port, no path), comma-separated.
# Example for a local MCP Inspector: http://localhost:6274. No wildcards.
# Requests without an Origin header do not need this setting; this is not
# an assistant/provider allowlist and cannot restrict MCP to OpenAI.
MCP_ALLOWED_ORIGINS=
