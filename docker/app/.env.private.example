# Copy this file to docker/app/.env.private for local secrets only.
# This file must stay out of Git.

GITHUB_BUGREPORT_TOKEN=
GITHUB_BUGREPORT_LABELS=
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_UPLOAD_API_KEY=
STADIA_MAPS_API_KEY=
# Local Etherpad development configuration. This key only protects the local Docker service.
ETHERPAD_URL=https://doc.localtest.me
ETHERPAD_API_KEY=omo-local-etherpad-development-key
ETHERPAD_API_VERSION=1.3.0
ETHERPAD_COOKIE_DOMAIN=.localtest.me

# Local EtherCalc development configuration. EtherCalc is exposed through Apache.
ETHERCALC_URL=https://calc.localtest.me
ETHERCALC_INTERNAL_URL=http://ethercalc:8000
ETHERCALC_KEY=omo-local-ethercalc-development-key

# Collabora reaches local WOPI endpoints through the Docker network.
COLLABORA_WOPI_BASE_URL=http://app
# Secret used to sign short-lived OMO to SpaceDeck access tokens.
SPACEDOCK_EXTERNAL_ACCESS_SECRET=replace-with-a-long-random-secret
# Public URL used by browser iframes and internal URL used by OMO to provision boards.
SPACEDECK_URL=https://whiteboard.localtest.me
SPACEDECK_INTERNAL_URL=http://spacedeck:9666
SPACEDECK_PROVISIONING_TOKEN=replace-with-a-long-random-provisioning-token
MAIL_USER=
MAIL_PASS=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=
