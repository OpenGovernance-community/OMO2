# Copy this file to docker/collabora/.env.private for local Collabora settings.
# This file must stay out of Git.

# WOPI hosts allowed to connect to Collabora. Keep the escaped dots.
aliasgroup1=http://app:80,https://localtest.me:443,https://.*\.localtest\.me:443

# TLS is terminated by the Apache reverse proxy in the app container.
DONT_GEN_SSL_CERT=true
extra_params=--o:ssl.enable=false --o:ssl.termination=true --o:welcome.enable=false

# Credentials for the local Collabora admin console.
username=admin
password=replace-with-a-local-secret
