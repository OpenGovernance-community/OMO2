# Copy this file to docker/spacedeck/.env.private for local SpaceDeck settings.
# This file must stay out of Git.
#
# The OMO endpoint validates short-lived access tokens and returns the user identity and role.
NODE_CONFIG={"team_name":"OpenMyOrganization Whiteboard local","contact_email":"support@localtest.me","host":"0.0.0.0","port":9666,"endpoint":"https://whiteboard.localtest.me","invite_code":"replace-with-a-local-secret","ext_access_control":"http://app/test/spacedeck_access.php","external_provisioning_secret":"replace-with-a-long-random-provisioning-token","export_api_secret":"replace-with-a-local-secret"}
