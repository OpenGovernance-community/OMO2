# Copy to /opt/jitsi/.env. Generate service passwords before starting.
JITSI_IMAGE_REPO=ghcr.io/jitsi
JITSI_IMAGE_VERSION=stable-11248-3
CONFIG=/opt/jitsi/config
TZ=Europe/Zurich
PUBLIC_URL=https://meet.opengov.tools
JVB_ADVERTISE_IPS=179.237.104.43
JVB_BIND_ADDRESS=0.0.0.0
JVB_PORT=10000
JVB_DISABLE_STUN=1
ENABLE_IPV6=0

# HTTPS is provided by the existing Caddy, not by the Jitsi web container.
HTTP_PORT=8000
HTTPS_PORT=8443
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
ENABLE_HSTS=0

# Temporary standalone authentication; OMO integration is not enabled yet.
ENABLE_AUTH=1
AUTH_TYPE=internal
ENABLE_GUESTS=1
ENABLE_LOBBY=1
ENABLE_AUTO_LOGIN=0
ENABLE_XMPP_WEBSOCKET=1
ENABLE_P2P=1
ENABLE_PREJOIN_PAGE=1
DEFAULT_LANGUAGE=fr
ENABLE_REQUIRE_DISPLAY_NAME=1

# Keep headroom for the other services on the 4 GB VPS.
JICOFO_MAX_MEMORY=256m
VIDEOBRIDGE_MAX_MEMORY=512m
ENABLE_RECORDING=0
ENABLE_LIVESTREAMING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_JAAS_COMPONENTS=0
ENABLE_THIRD_PARTY_REQUESTS=0
RTCSTATS_ENABLED=0

# Generated using the release's gen-passwords.sh. Never commit real values.
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
