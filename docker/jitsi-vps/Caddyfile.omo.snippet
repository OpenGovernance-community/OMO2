# Replace only the existing meet block AFTER publishing OMO2 and activating compose.omo.yaml.
# Adapt the canonical OMO2 origin for another installation.
meet.opengov.tools {
    @start path /
    redir @start https://omo2.org/visio/ 302

    @invitation {
        path_regexp invitation ^/omo-([a-f0-9]{32})/?$
        not query jwt=*
    }
    redir @invitation https://omo2.org/visio/{re.invitation.1} 302

    reverse_proxy jitsi-web:8000
}
